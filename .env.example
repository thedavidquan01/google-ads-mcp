# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=xxx
GOOGLE_ADS_CUSTOMER_ID=xxx              # MCC or individual account (format: 123-456-7890)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=           # Optional: MCC ID if using manager account

# Google OAuth 2.0
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=https://sp-google-ads-mcp.fly.dev/auth/callback

# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
REQUIRE_AUTH=true
SESSION_SECRET=change-me-to-a-secure-random-string-32chars

# Google Cloud (Gemini + Firestore + Storage)
GOOGLE_SERVICE_ACCOUNT_JSON=            # Full JSON of service account key
GCS_BUCKET_NAME=google-ads-videos
GCP_PROJECT_ID=
FIRESTORE_CACHE_TTL_HOURS=24

# Gemini AI (for video creative analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_VERTEX_AI=false
GEMINI_MAX_COST_PER_ANALYSIS=0.10
GEMINI_MAX_CONCURRENT_ANALYSES=2

# YouTube Data API
# (uses same OAuth token — youtube.readonly scope)
# No additional config needed
